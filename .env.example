# Copy to .env and adjust. All values are optional; they override config/app.yaml.

# AWS
AWS_REGION=us-east-1
# Use a named profile if you don't rely on the default credential chain:
# AWS_PROFILE=agentDemoUser

# Bedrock model (Claude 3.5 Sonnet is legacy/unavailable on this account;
# default is Claude Sonnet 4.5). Override here if you have a different model.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Memory backend: auto | agentcore | local
MEMORY_BACKEND=auto
# Set after running scripts/provision_memory.py to switch on AgentCore Memory:
# AGENTCORE_MEMORY_ID=EkycOnboardingMemory-xxxxxxxxxx

# Agent execution mode: local (in-process Strands) or runtime (deployed AgentCore Runtime).
# For runtime mode, set the ARN printed by deploy/deploy_runtime.py.
AGENT_MODE=local
# AGENTCORE_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:<acct>:runtime/ekyc_onboarding_agent-xxxx

# Server
HOST=127.0.0.1
PORT=8080
